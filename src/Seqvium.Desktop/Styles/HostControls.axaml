<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource Type.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Background}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="StackPanel">
        <Setter Property="Spacing" Value="{DynamicResource Space.Gap}" />
    </Style>
    <Style Selector="StackPanel.joined">
        <Setter Property="Spacing" Value="0" />
    </Style>
    <Style Selector="StackPanel.tight">
        <Setter Property="Spacing" Value="{DynamicResource Space.XSmall}" />
    </Style>
    <Style Selector="StackPanel.compact">
        <Setter Property="Spacing" Value="{DynamicResource Space.Small}" />
    </Style>
    <Style Selector="StackPanel.spaced">
        <Setter Property="Spacing" Value="{DynamicResource Space.Medium}" />
    </Style>
    <Style Selector="StackPanel.section">
        <Setter Property="Spacing" Value="{DynamicResource Space.Section}" />
    </Style>
    <Style Selector="TextBlock.secondary, TextBlock.caption">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource Type.Caption}" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{DynamicResource Type.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.paneTitle">
        <Setter Property="FontSize" Value="{DynamicResource Type.PaneTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.brand">
        <Setter Property="FontFamily" Value="{DynamicResource Type.BrandFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Brand}" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="LetterSpacing" Value="{DynamicResource Type.BrandTracking}" />
    </Style>
    <Style Selector="TextBlock.numeric">
        <Setter Property="FontSize" Value="{DynamicResource Type.Numeric}" />
        <Setter Property="FontFamily" Value="{DynamicResource Type.MonospaceFamily}" />
    </Style>
    <Style Selector="TextBox.numeric, NumericUpDown">
        <Setter Property="FontSize" Value="{DynamicResource Type.Numeric}" />
        <Setter Property="FontFamily" Value="{DynamicResource Type.MonospaceFamily}" />
    </Style>
    <Style Selector="TextBlock.monospace">
        <Setter Property="FontFamily" Value="{DynamicResource Type.MonospaceFamily}" />
    </Style>
    <Style Selector="TextBox.monospace">
        <Setter Property="FontFamily" Value="{DynamicResource Type.MonospaceFamily}" />
    </Style>
    <Style Selector="Button, ToggleButton">
        <Setter Property="Height" Value="{DynamicResource Control.Height}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Background" Value="{DynamicResource Material.Button}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Control}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Control}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.comfortable">
        <Setter Property="Height" Value="{DynamicResource Control.ComfortableHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.ComfortableHeight}" />
    </Style>
    <Style Selector="Button.chrome">
        <Setter Property="Width" Value="{DynamicResource Chrome.ButtonWidth}" />
        <Setter Property="Height" Value="{DynamicResource Pane.HeaderHeight}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.paneChrome">
        <Setter Property="Width" Value="{DynamicResource Control.Height}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.workspacePane">
        <Setter Property="BoxShadow" Value="{DynamicResource Material.PanelShadow}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Control}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Pane.Corner}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
    </Style>
    <Style Selector="Border.workspacePane.active">
        <Setter Property="BorderBrush" Value="{DynamicResource Focus.Active}" />
    </Style>
    <Style Selector="Border.paneHeader">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Control}" />
        <Setter Property="Height" Value="{DynamicResource Pane.HeaderHeight}" />
    </Style>
    <Style Selector="Grid.parameterRow">
        <Setter Property="ColumnSpacing" Value="{DynamicResource Space.Small}" />
        <Setter Property="RowSpacing" Value="{DynamicResource Space.Small}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.InputHeight}" />
    </Style>
    <Style Selector="Grid.parameterRow > TextBlock, StackPanel.parameterRow > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="Grid.parameterRow > TextBox, StackPanel.parameterRow > TextBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.parameterRow > Button, StackPanel.parameterRow > Button">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="{DynamicResource Control.InputHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Surface.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="NumericUpDown.invalid">
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="NumericUpDown.invalid /template/ TextBox">
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="TextBox.warning /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning}" />
    </Style>
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource Status.Playing}" />
    </Style>
    <Style Selector="Slider">
        <Setter Property="MinHeight" Value="{DynamicResource Level.Height}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
        <Setter Property="Height" Value="{DynamicResource Pane.HeaderHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource Pane.HeaderHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar[Orientation=Vertical]">
        <Setter Property="Margin" Value="{DynamicResource ScrollBar.VerticalGutter}" />
    </Style>
    <Style Selector="ScrollBar[Orientation=Horizontal]">
        <Setter Property="Margin" Value="{DynamicResource ScrollBar.HorizontalGutter}" />
    </Style>
    <Style Selector="Button.command, Button.icon">
        <Setter Property="Width" Value="{DynamicResource Control.IconWidth}" />
        <Setter Property="Height" Value="{DynamicResource Control.Height}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Icon}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Popup}" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
    </Style>
    <Style Selector="Button.command /template/ ContentPresenter, Button.icon /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style
        Selector="Button.command:pointerover /template/ ContentPresenter, Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    </Style>
    <Style
        Selector="Button.command:disabled /template/ ContentPresenter, Button.icon:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Pressed}" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Focus.Active}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Focus}" />
    </Style>
    <Style Selector="Button.play">
        <Setter Property="Foreground" Value="{DynamicResource Status.Playing}" />
    </Style>
    <Style Selector="Button.play.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Playing}" />
    </Style>
    <Style Selector="Button.critical">
        <Setter Property="Foreground" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="Button.critical:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Critical}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{DynamicResource Accent.Action}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Action}" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="Button.audition">
        <Setter Property="Height" Value="{DynamicResource Audition.Height}" />
        <Setter Property="MinHeight" Value="{DynamicResource Audition.Height}" />
        <Setter Property="MinWidth" Value="{DynamicResource Audition.MinWidth}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Audition.Corner}" />
        <Setter Property="Background" Value="{DynamicResource Material.Button}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.audition.stop">
        <Setter Property="MinWidth" Value="{DynamicResource Audition.Height}" />
        <Setter Property="Width" Value="{DynamicResource Audition.Height}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Critical}" />
    </Style>
    <Style Selector="Button.compact">
        <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{DynamicResource State.Unavailable}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="Height" Value="{DynamicResource Control.Height}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.ComboBox}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="Height" Value="{DynamicResource Control.Height}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Numeric}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Numeric}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.NumericInnerHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="Button.status">
        <Setter Property="Height" Value="{DynamicResource Control.StatusHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.StatusHeight}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Status}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Caption}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.status.warning">
        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
    </Style>
    <Style Selector="Button.status.error">
        <Setter Property="Foreground" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="Button.status.playing">
        <Setter Property="Foreground" Value="{DynamicResource Status.Playing}" />
    </Style>

    <!-- Music-specific pad: state is conveyed by fill, inset pulse and toggle automation. -->
    <Style Selector="ToggleButton.step">
        <Setter Property="Width" Value="{DynamicResource Rack.StepHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource Rack.StepHeight}" />
        <Setter Property="MaxWidth" Value="{DynamicResource Rack.StepHeight}" />
        <Setter Property="Height" Value="{DynamicResource Rack.StepHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource Rack.StepHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rack.StepBorder}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="StepSurface" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource Rack.StepCorner}"
                        BoxShadow="{DynamicResource Material.PadShadow}">
                    <Grid>
                        <Border CornerRadius="{DynamicResource Rack.StepCorner}"
                                Background="{DynamicResource Material.Bevel}" />
                        <Border Name="StepCap" Margin="3,3,3,5" CornerRadius="{DynamicResource Rack.StepCorner}"
                                BorderBrush="{DynamicResource Material.Highlight}"
                                BorderThickness="{DynamicResource Border.Control}"
                                Opacity="0.3" />
                        <Border Name="StepHover" CornerRadius="{DynamicResource Rack.StepCorner}"
                                Background="{DynamicResource Material.Highlight}" Opacity="0" />
                        <Border Name="StepPress" CornerRadius="{DynamicResource Rack.StepCorner}"
                                Background="{DynamicResource Material.Shade}" Opacity="0" />
                        <Border Name="Pulse" Width="12" Height="3" CornerRadius="1" Opacity="0"
                                Background="{DynamicResource Rack.StepInk}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        <Border Name="StepFocus" BorderThickness="2" Margin="-2"
                                CornerRadius="{DynamicResource Rack.StepCorner}"
                                BorderBrush="{DynamicResource Focus.Active}" IsVisible="False" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.step:checked /template/ Border#Pulse">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.step:pointerover /template/ Border#StepSurface">
        <Setter Property="BorderBrush" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style Selector="ToggleButton.step:pointerover /template/ Border#StepHover">
        <Setter Property="Opacity" Value="0.12" />
    </Style>
    <Style Selector="ToggleButton.step:pressed /template/ Border#StepPress">
        <Setter Property="Opacity" Value="0.3" />
    </Style>
    <Style Selector="ToggleButton.step:pressed /template/ Border#StepCap">
        <Setter Property="Margin" Value="3,5,3,3" />
    </Style>
    <Style Selector="ToggleButton.step:focus-visible /template/ Border#StepFocus">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ToggleButton.step:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.rail">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style Selector="Button.rail.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Accent}" />
    </Style>
    <Style Selector="Button.rail.active">
        <Setter Property="Foreground" Value="{DynamicResource Accent.Action}" />
    </Style>
    <Style Selector="Button.play">
        <Setter Property="Width" Value="40" />
        <Setter Property="Background" Value="{DynamicResource Surface.Playing}" />
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Content}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource Accent.Action}" />
    </Style>
    <Style Selector="Button.mixerControl, TextBox.mixerValue">
        <Setter Property="FontSize" Value="{DynamicResource Type.Caption}" />
        <Setter Property="Height" Value="{DynamicResource Mixer.ControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource Mixer.ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Numeric}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Grid.mixerValueRow">
        <Setter Property="MinHeight" Value="{DynamicResource Mixer.ControlHeight}" />
        <Setter Property="ColumnSpacing" Value="1" />
    </Style>
    <Style Selector="Button.mixerControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.mixerControl.primary">
        <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Action}" />
    </Style>
    <Style Selector="TextBox.patternName">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.step.channel0">
        <Setter Property="Background" Value="{DynamicResource Rack.Step0}" />
    </Style>
    <Style Selector="ToggleButton.step.channel0:checked">
        <Setter Property="Background" Value="{DynamicResource Rack.Channel0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rack.Channel0}" />
    </Style>
    <Style Selector="ToggleButton.step.channel1">
        <Setter Property="Background" Value="{DynamicResource Rack.Step1}" />
    </Style>
    <Style Selector="ToggleButton.step.channel1:checked">
        <Setter Property="Background" Value="{DynamicResource Rack.Channel1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rack.Channel1}" />
    </Style>
    <Style Selector="ToggleButton.step.channel2">
        <Setter Property="Background" Value="{DynamicResource Rack.Step2}" />
    </Style>
    <Style Selector="ToggleButton.step.channel2:checked">
        <Setter Property="Background" Value="{DynamicResource Rack.Channel2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rack.Channel2}" />
    </Style>
    <Style Selector="ToggleButton.step.channel3">
        <Setter Property="Background" Value="{DynamicResource Rack.Step3}" />
    </Style>
    <Style Selector="ToggleButton.step.channel3:checked">
        <Setter Property="Background" Value="{DynamicResource Rack.Channel3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rack.Channel3}" />
    </Style>
    <Style Selector="ToggleButton.step.channel4">
        <Setter Property="Background" Value="{DynamicResource Rack.Step4}" />
    </Style>
    <Style Selector="ToggleButton.step.channel4:checked">
        <Setter Property="Background" Value="{DynamicResource Rack.Channel4}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rack.Channel4}" />
    </Style>
    <Style Selector="ToggleButton.step.channel5">
        <Setter Property="Background" Value="{DynamicResource Rack.Step5}" />
    </Style>
    <Style Selector="ToggleButton.step.channel5:checked">
        <Setter Property="Background" Value="{DynamicResource Rack.Channel5}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rack.Channel5}" />
    </Style>
    <Style Selector="ToggleButton.step.channel6">
        <Setter Property="Background" Value="{DynamicResource Rack.Step6}" />
    </Style>
    <Style Selector="ToggleButton.step.channel6:checked">
        <Setter Property="Background" Value="{DynamicResource Rack.Channel6}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rack.Channel6}" />
    </Style>
    <Style Selector="ToggleButton.step.channel7">
        <Setter Property="Background" Value="{DynamicResource Rack.Step7}" />
    </Style>
    <Style Selector="ToggleButton.step.channel7:checked">
        <Setter Property="Background" Value="{DynamicResource Rack.Channel7}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Rack.Channel7}" />
    </Style>
    <Style Selector="ToggleButton.step.channel0:checked /template/ Border#StepSurface">
        <Setter Property="BoxShadow" Value="{DynamicResource Material.Glow0}" />
    </Style>
    <Style Selector="ToggleButton.step.channel1:checked /template/ Border#StepSurface">
        <Setter Property="BoxShadow" Value="{DynamicResource Material.Glow1}" />
    </Style>
    <Style Selector="ToggleButton.step.channel2:checked /template/ Border#StepSurface">
        <Setter Property="BoxShadow" Value="{DynamicResource Material.Glow2}" />
    </Style>
    <Style Selector="ToggleButton.step.channel3:checked /template/ Border#StepSurface">
        <Setter Property="BoxShadow" Value="{DynamicResource Material.Glow3}" />
    </Style>
    <Style Selector="ToggleButton.step.channel4:checked /template/ Border#StepSurface">
        <Setter Property="BoxShadow" Value="{DynamicResource Material.Glow4}" />
    </Style>
    <Style Selector="ToggleButton.step.channel5:checked /template/ Border#StepSurface">
        <Setter Property="BoxShadow" Value="{DynamicResource Material.Glow5}" />
    </Style>
    <Style Selector="ToggleButton.step.channel6:checked /template/ Border#StepSurface">
        <Setter Property="BoxShadow" Value="{DynamicResource Material.Glow6}" />
    </Style>
    <Style Selector="ToggleButton.step.channel7:checked /template/ Border#StepSurface">
        <Setter Property="BoxShadow" Value="{DynamicResource Material.Glow7}" />
    </Style>
    <Style Selector="ToggleButton.step:pressed /template/ Border#StepSurface">
        <Setter Property="BoxShadow" Value="{DynamicResource Material.Recess}" />
    </Style>
    <Style Selector="ToggleButton.step.current /template/ Border#StepSurface">
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Playing}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Focus}" />
    </Style>
    <Style Selector="Grid.dropReady">
        <Setter Property="Background" Value="{DynamicResource Surface.Accent}" />
    </Style>
    <Style Selector="Button.command.play /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Playing}" />
    </Style>
    <Style Selector="Button.command.play:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Material.Button}" />
    </Style>
</Styles>
