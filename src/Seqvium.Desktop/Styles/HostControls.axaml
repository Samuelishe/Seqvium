<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource Type.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Background}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="StackPanel">
        <Setter Property="Spacing" Value="{DynamicResource Space.Gap}" />
    </Style>
    <Style Selector="StackPanel.joined">
        <Setter Property="Spacing" Value="0" />
    </Style>
    <Style Selector="StackPanel.tight">
        <Setter Property="Spacing" Value="{DynamicResource Space.XSmall}" />
    </Style>
    <Style Selector="StackPanel.compact">
        <Setter Property="Spacing" Value="{DynamicResource Space.Small}" />
    </Style>
    <Style Selector="StackPanel.spaced">
        <Setter Property="Spacing" Value="{DynamicResource Space.Medium}" />
    </Style>
    <Style Selector="StackPanel.section">
        <Setter Property="Spacing" Value="{DynamicResource Space.Section}" />
    </Style>
    <Style Selector="TextBlock.secondary, TextBlock.caption">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource Type.Caption}" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{DynamicResource Type.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.paneTitle">
        <Setter Property="FontSize" Value="{DynamicResource Type.PaneTitle}" />
    </Style>
    <Style Selector="TextBlock.numeric">
        <Setter Property="FontSize" Value="{DynamicResource Type.Numeric}" />
    </Style>
    <Style Selector="TextBox.numeric, NumericUpDown">
        <Setter Property="FontSize" Value="{DynamicResource Type.Numeric}" />
    </Style>
    <Style Selector="TextBlock.monospace">
        <Setter Property="FontFamily" Value="{DynamicResource Type.MonospaceFamily}" />
    </Style>
    <Style Selector="TextBox.monospace">
        <Setter Property="FontFamily" Value="{DynamicResource Type.MonospaceFamily}" />
    </Style>
    <Style Selector="Button, ToggleButton">
        <Setter Property="Height" Value="{DynamicResource Control.Height}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Control}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Control}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.comfortable">
        <Setter Property="Height" Value="{DynamicResource Control.ComfortableHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.ComfortableHeight}" />
    </Style>
    <Style Selector="Button.chrome">
        <Setter Property="Width" Value="{DynamicResource Chrome.ButtonWidth}" />
        <Setter Property="Height" Value="{DynamicResource Pane.HeaderHeight}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.paneChrome">
        <Setter Property="Width" Value="{DynamicResource Control.Height}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.workspacePane">
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Control}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Pane.Corner}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
    </Style>
    <Style Selector="Border.workspacePane.active">
        <Setter Property="BorderBrush" Value="{DynamicResource Focus.Active}" />
    </Style>
    <Style Selector="Border.paneHeader">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Control}" />
        <Setter Property="Height" Value="{DynamicResource Pane.HeaderHeight}" />
    </Style>
    <Style Selector="Grid.parameterRow">
        <Setter Property="ColumnSpacing" Value="{DynamicResource Space.Small}" />
        <Setter Property="RowSpacing" Value="{DynamicResource Space.Small}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.InputHeight}" />
    </Style>
    <Style Selector="Grid.parameterRow > TextBlock, StackPanel.parameterRow > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="Grid.parameterRow > TextBox, StackPanel.parameterRow > TextBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.parameterRow > Button, StackPanel.parameterRow > Button">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="{DynamicResource Control.InputHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Surface.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="TextBox.warning /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Status.Warning}" />
    </Style>
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource Status.Playing}" />
    </Style>
    <Style Selector="Slider">
        <Setter Property="MinHeight" Value="{DynamicResource Level.Height}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
        <Setter Property="Height" Value="{DynamicResource Pane.HeaderHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource Pane.HeaderHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="Button.command, Button.icon">
        <Setter Property="Width" Value="{DynamicResource Control.IconWidth}" />
        <Setter Property="Height" Value="{DynamicResource Control.Height}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Icon}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Popup}" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
    </Style>
    <Style Selector="Button.command /template/ ContentPresenter, Button.icon /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.command:pointerover /template/ ContentPresenter, Button.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    </Style>
    <Style Selector="Button.command:disabled /template/ ContentPresenter, Button.icon:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Pressed}" />
    </Style>
    <Style Selector="Button:focus-visible /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Focus.Active}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Focus}" />
    </Style>
    <Style Selector="Button.play">
        <Setter Property="Foreground" Value="{DynamicResource Status.Playing}" />
    </Style>
    <Style Selector="Button.play.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Playing}" />
    </Style>
    <Style Selector="Button.critical">
        <Setter Property="Foreground" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="Button.critical:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Critical}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{DynamicResource Accent.Action}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Action}" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Critical}" />
    </Style>
    <Style Selector="Button.compact">
        <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{DynamicResource State.Unavailable}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="Height" Value="{DynamicResource Control.Height}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.ComboBox}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="Height" Value="{DynamicResource Control.Height}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Numeric}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Numeric}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.NumericInnerHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="Button.status">
        <Setter Property="Height" Value="{DynamicResource Control.StatusHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.StatusHeight}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Status}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Caption}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.status.warning">
        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
    </Style>
    <Style Selector="Button.status.error">
        <Setter Property="Foreground" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="Button.status.playing">
        <Setter Property="Foreground" Value="{DynamicResource Status.Playing}" />
    </Style>
</Styles>
