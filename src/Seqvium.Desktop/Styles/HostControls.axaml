<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Button.command">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="Button.shell:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
    </Style>
    <Style Selector="Button.command /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.command:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
    </Style>
    <Style Selector="Button.command:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.shell:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Pressed}" />
    </Style>
    <Style Selector="Button.shell:focus-visible /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Focus.Active}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.play">
        <Setter Property="Foreground" Value="{DynamicResource Status.Playing}" />
    </Style>
    <Style Selector="Button.play.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Playing}" />
    </Style>
    <Style Selector="Button.critical">
        <Setter Property="Foreground" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="Button.critical:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Surface.Critical}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{DynamicResource Accent.Action}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Action}" />
    </Style>
    <Style Selector="Button.shell:disabled">
        <Setter Property="Foreground" Value="{DynamicResource State.Unavailable}" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="ComboBox.workflow">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="6,0,24,0" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="NumericUpDown.workflow">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
    </Style>
    <Style Selector="NumericUpDown.workflow /template/ TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
    </Style>
    <Style Selector="Button.status">
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,0,6,0" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Caption}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.status.warning">
        <Setter Property="Foreground" Value="{DynamicResource Status.Warning}" />
    </Style>
    <Style Selector="Button.status.error">
        <Setter Property="Foreground" Value="{DynamicResource Status.Critical}" />
    </Style>
    <Style Selector="Button.status.playing">
        <Setter Property="Foreground" Value="{DynamicResource Status.Playing}" />
    </Style>
</Styles>
