<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Seqvium.Desktop.App">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="{DynamicResource Type.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>
        <Style Selector="Button.shell">
            <Setter Property="Height" Value="{DynamicResource Control.Height}" />
            <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
            <Setter Property="FontSize" Value="{DynamicResource Type.Body}" />
            <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Control.Corner}" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.shell:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface.Workspace}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Action}" />
        </Style>
        <Style Selector="Button.shell:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Focus.Active}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.shell:disabled">
            <Setter Property="Foreground" Value="{DynamicResource State.Unavailable}" />
        </Style>
        <Style Selector="Button.shell:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Action}" />
        </Style>
    </Application.Styles>
</Application>
