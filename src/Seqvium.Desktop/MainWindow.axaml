<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:Seqvium.Desktop.Presentation" x:Class="Seqvium.Desktop.MainWindow" x:DataType="p:ShellSession"
        Title="Seqvium" Width="1400" Height="900" MinWidth="640" MinHeight="480" CanResize="True"
        Background="{DynamicResource Surface.Background}" WindowStartupLocation="CenterScreen"
        Icon="avares://Seqvium.Desktop/Assets/Brand/seqvium.ico">
    <Window.Resources>
        <ControlTheme x:Key="HostChrome" TargetType="WindowDrawnDecorations">
            <Setter Property="Template">
                <WindowDrawnDecorationsTemplate>
                    <WindowDrawnDecorationsContent />
                </WindowDrawnDecorationsTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border x:Name="Chrome" Height="{DynamicResource Chrome.Height}" Background="{DynamicResource Material.Panel}"
                BorderThickness="{DynamicResource Border.Bottom}" BorderBrush="{DynamicResource Border.Default}">
            <Grid ColumnDefinitions="*,Auto">
                <Grid x:Name="TitleRegion" ColumnDefinitions="Auto,*,Auto" Background="Transparent"
                      Margin="{DynamicResource Padding.Control}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.Small}" VerticalAlignment="Center">
                        <Image Source="avares://Seqvium.Desktop/Assets/Brand/Icons/seqvium-32.png"
                               Width="{DynamicResource Brand.ChromeSize}" Height="{DynamicResource Brand.ChromeSize}"
                               IsHitTestVisible="False" />
                        <TextBlock x:Name="BrandName" Text="Seqvium" Classes="brand" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis"
                               Margin="12,0,6,0" VerticalAlignment="Center" ToolTip.Tip="{Binding ProjectName}" />
                    <TextBlock Grid.Column="2" Text="{Binding ProjectStatus}" Classes="caption"
                               VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ProjectStatus}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Classes="joined">
                    <Button x:Name="ThemeAction" Classes="shell chrome" Click="ThemeClicked"
                            AutomationProperties.AutomationId="Preference.Theme" />
                <StackPanel x:Name="WindowActions" Orientation="Horizontal" Classes="joined">
                    <Button x:Name="MinimizeAction" Classes="shell chrome" Click="MinimizeClicked"
                            AutomationProperties.AutomationId="Window.Minimize"
                            AutomationProperties.Name="{Binding [Window.Minimize]}"
                            ToolTip.Tip="{Binding [Window.Minimize]}" />
                    <Button x:Name="MaximizeAction" Classes="shell chrome" Click="MaximizeClicked"
                            AutomationProperties.AutomationId="Window.Maximize" />
                    <Button x:Name="CloseAction" Classes="shell chrome" Click="CloseClicked"
                            AutomationProperties.AutomationId="Window.Close"
                            AutomationProperties.Name="{Binding [Window.Close]}" ToolTip.Tip="{Binding [Window.Close]}" />
                </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Height="{DynamicResource Toolbar.Height}" Background="{DynamicResource Material.Panel}"
                BorderBrush="{DynamicResource Border.Default}" BorderThickness="{DynamicResource Border.Bottom}"
                Padding="{DynamicResource Padding.Control}">
            <Grid ColumnDefinitions="*,Auto">
                <Border x:Name="WorkflowRegion" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Space.Gap}"
                            VerticalAlignment="Center">
                    <Button x:Name="PaneMenuAction" Classes="shell command"
                            AutomationProperties.AutomationId="Workspace.Panes"
                            AutomationProperties.Name="{Binding [Workspace.Panes]}"
                            ToolTip.Tip="{Binding [Workspace.KeyboardHint]}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="{DynamicResource Space.Small}">
                                    <Button Classes="shell" Content="{Binding [Workspace.MusicLayout]}"
                                            Click="MusicLayoutClicked"
                                            AutomationProperties.AutomationId="Workspace.MusicLayout" />
                                    <Button Classes="shell" Content="{Binding [Pane.Beat]}"
                                            Click="BeatClicked"
                                            AutomationProperties.AutomationId="Workspace.OpenBeat" />
                                    <Button Classes="shell" Content="{Binding [Pane.SampleLab]}" Click="SampleLabClicked" />
                                    <Button Classes="shell" Content="{Binding [Pane.Browser]}" Click="BrowserClicked"
                                            AutomationProperties.AutomationId="Workspace.OpenBrowser" />
                                    <Button Classes="shell" Content="{Binding [Pane.Arrangement]}"
                                            Click="ArrangementClicked"
                                            AutomationProperties.AutomationId="Workspace.OpenArrangement" />
                                    <Button Classes="shell" Content="{Binding [Pane.Piano]}" Click="PianoClicked"
                                            AutomationProperties.AutomationId="Workspace.OpenPiano" />
                                    <Button Classes="shell" Content="{Binding [Pane.Mixer]}" Click="MixerClicked"
                                            AutomationProperties.AutomationId="Workspace.OpenMixer" />
                                    <Button Classes="shell" Content="{Binding [Pane.Inspector]}"
                                            Click="InspectorClicked"
                                            AutomationProperties.AutomationId="Workspace.OpenInspector" />
                                    <Button Classes="shell" Content="{Binding [Pane.Graph]}"
                                            Click="GraphClicked"
                                            AutomationProperties.AutomationId="Workspace.OpenGraph" />
                                    <Button Classes="shell" Content="{Binding [Pane.NodeEditor]}"
                                            Click="NodeEditorClicked"
                                            AutomationProperties.AutomationId="Workspace.OpenNodeEditor" />
                                    <TextBlock Classes="caption" Text="{Binding [Workspace.KeyboardHint]}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SettingsAction" Classes="shell command" Click="SettingsClicked"
                            AutomationProperties.AutomationId="Settings.Open"
                            AutomationProperties.Name="{Binding [Settings.Title]}" ToolTip.Tip="{Binding [Settings.Title]}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
            <Border x:Name="NavigationRegion" />
            <Border Grid.Column="1" x:Name="WorkspaceRegion" Background="{DynamicResource Surface.Workspace}" />
        </Grid>
        <Border Grid.Row="3" Height="{DynamicResource Status.Height}" BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="{DynamicResource Border.Top}" Padding="{DynamicResource Padding.Control}">
            <Grid ColumnDefinitions="*,Auto">
                <Border x:Name="WorkflowStatusRegion" />
                <TextBlock Grid.Column="1" Text="{Binding Notice}" IsVisible="{Binding HasNotice}" Margin="12,0,0,0"
                           FontSize="{DynamicResource Type.Caption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Status.Warning}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Notice}" />
            </Grid>
        </Border>
    </Grid>
</Window>
