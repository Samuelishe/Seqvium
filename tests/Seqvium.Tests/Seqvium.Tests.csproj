<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-v1" Version="3.2.2"/>
        <ProjectReference Include="../../src/Seqvium.Core/Seqvium.Core.csproj"/>
        <ProjectReference Include="../../src/Seqvium.Desktop/Seqvium.Desktop.csproj"/>
        <ProjectReference Include="../../tools/Seqvium.Tools.ProjectStats/Seqvium.Tools.ProjectStats.csproj"/>
        <ProjectReference Include="../../tools/Seqvium.VisualCheck/Seqvium.VisualCheck.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="../../examples/Neon Orchard/Neon Orchard.seqvium;../../examples/Neon Orchard/MEDIA.json"
              Link="Examples/Neon Orchard/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="../../examples/Neon Orchard/Neon Orchard.seqvium.media/**/*.wav"
              Link="Examples/Neon Orchard/Neon Orchard.seqvium.media/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="../../examples/Neon Orchard/checkpoints/*.json"
              Link="Examples/Neon Orchard/checkpoints/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
